; Engine configuration file.
; Godot 4.7 — ShyneB0X Music Player (digit zero in B0X)
config_version=5

[application]

config/name="ShyneB0X Music Player"
config/description="Local music player (ShyneB0X Music Player)."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=720
window/size/viewport_height=512
window/size/min_width=640
window/size/min_height=440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://themes/chrome_2003.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
